<?xml version="1.0" encoding="UTF-8"?>
<widget version="0.2">
    <title xml:lang="ko">XENARA 소셜로그인 위젯</title>
    <description xml:lang="ko">페이스북 등 소셜로그인을 할 수 있는 위젯입니다.</description>
    <version>1.8.14</version>
    <date>2015-11</date>

    <author email_address="kolaskks@naver.com" link="http://xenara.zaggu.net/">
        <name xml:lang="ko">XENARA</name>
    </author>

    <extra_vars>
        <group>
            <title xml:lang="ko">페이스북 설정</title>
            <var id="facebook_app_id" type="text">
                <name xml:lang="ko">페이스북 'App ID'</name>
                <description xml:lang="ko">페이스북 'App ID'를 입력하세요.</description>
            </var>
            <var id="facebook_app_version" type="text">
                <name xml:lang="ko">페이스북 'App Version'</name>
                <description xml:lang="ko">페이스북 'App Version'를 입력하세요. (기본: v2.5)</description>
            </var>
        </group>


        <group>
            <title xml:lang="ko">트위터 설정</title>
            <var id="twitter_consumer_key" type="text">
                <name xml:lang="ko">트위터 'Consumer Key'</name>
                <description xml:lang="ko">트위터 'Consumer Key'를 입력하세요.</description>
            </var>
            <var id="twitter_consumer_secret" type="text">
                <name xml:lang="ko">트위터 'Consumer Secret'</name>
                <description xml:lang="ko">트위터 'Consumer Secret'를 입력하세요.</description>
            </var>
        </group>


        <group>
            <title xml:lang="ko">구글 설정</title>
            <var id="google_client_id" type="text">
                <name xml:lang="ko">구글 'Client ID'</name>
                <description xml:lang="ko">구글 'Client ID'를 입력하세요.</description>
            </var>
        </group>


        <group>
            <title xml:lang="ko">네이버 설정</title>
            <var id="naver_client_id" type="text">
                <name xml:lang="ko">네이버 'Client ID'</name>
                <description xml:lang="ko">네이버 'Client ID'를 입력하세요.</description>
            </var>
        </group>


        <group>
            <title xml:lang="ko">카카오 설정</title>
            <var id="kakao_rest_key" type="text">
                <name xml:lang="ko">카카오 'REST API 키'</name>
                <description xml:lang="ko">카카오 'REST API 키'를 입력하세요.</description>
            </var>
            <var id="kakao_js_key" type="text">
                <name xml:lang="ko">카카오 'JavaScript 키'</name>
                <description xml:lang="ko">카카오 'JavaScript 키'를 입력하세요.</description>
            </var>
        </group>


        <group>
            <title xml:lang="ko">회원가입 알림 메일 설정</title>
            <var id="sender_name" type="text">
                <name xml:lang="ko">보내는 사람 이름</name>
                <description xml:lang="ko">메일 보내는 사람 이름을 입력하세요. (기본: 웹마스터)</description>
            </var>
            <var id="sender_email" type="text">
                <name xml:lang="ko">보내는 사람 이메일</name>
                <description xml:lang="ko">메일 보내는 사람 이메일를 입력하세요. (기본: webmaster@도메인)</description>
            </var>
            <var id="email_title" type="text">
                <name xml:lang="ko">이메일 제목</name>
                <description xml:lang="ko">이메일 제목을 입력하세요.</description>
            </var>
        </group>


        <group>
            <title xml:lang="ko">기타 설정</title>
            <var id="use_login_point" type="select">
                <name xml:lang="ko">로그인 포인트 지급유무</name>
                <description xml:lang="ko">로그인 시 연동되는 포인트 지급 사용유무를 선택하세요.</description>
                <options>
                    <value>Y</value>
                    <name xml:lang="ko">사용</name>
                </options>
                <options>
                    <value>N</value>
                    <name xml:lang="ko">사용안함</name>
                </options>
            </var>
        </group>


        <group>
            <title xml:lang="ko">각종문구 설정</title>
            <var id="text_input_email_description" type="text">
                <name xml:lang="ko">'XE등록 및 임시비번을 전송받을 이메일을 입력해주세요.' 문구</name>
                <description xml:lang="ko">'XE등록 및 임시비번을 전송받을 이메일을 입력해주세요.' 문구를 입력하세요.</description>
            </var>
            <var id="text_alert_input_email" type="text">
                <name xml:lang="ko">'이메일주소를 입력하세요.' 문구</name>
                <description xml:lang="ko">'이메일주소를 입력하세요.' 문구를 입력하세요.</description>
            </var>
            <var id="text_alert_wrong_email" type="text">
                <name xml:lang="ko">'잘못된 이메일 형식입니다.' 문구</name>
                <description xml:lang="ko">'잘못된 이메일 형식입니다.' 문구를 입력하세요.</description>
            </var>


            <var id="text_message_id" type="text">
                <name xml:lang="ko">이메일 내용 '아이디' 문구</name>
                <description xml:lang="ko">이메일 내용 '아이디' 문구를 입력하세요. (기본: 아이디)</description>
            </var>
            <var id="text_message_temp_pw" type="text">
                <name xml:lang="ko">이메일 내용 '임시비번' 문구</name>
                <description xml:lang="ko">이메일 내용 '임시비번' 문구를 입력하세요. (기본: 임시비번)</description>
            </var>
            <var id="text_message_change_pw" type="text">
                <name xml:lang="ko">이메일 내용 '비번변경' 문구</name>
                <description xml:lang="ko">이메일 내용 '비번변경' 문구를 입력하세요. (기본: 비번변경)</description>
            </var>
        </group>
    </extra_vars>
</widget>
