<?xml version="1.0" encoding="UTF-8"?>
<widget version="0.2">
    <title xml:lang="ko">유튜브 채널 위젯</title>
    <description xml:lang="ko">지정한 유튜브 채널의 최신 동영상을 불러옵니다.</description>
    <version>1.0.0</version>
    <date>2026-04-01</date>
    <author email="your@email.com" link="[https://yourdomain.com](https://yourdomain.com)">
        <name xml:lang="ko">개발자이름</name>
    </author>
    <extra_vars>
        <var id="api_key">
            <type>text</type>
            <name xml:lang="ko">YouTube API Key</name>
            <description xml:lang="ko">Google Cloud Console에서 발급받은 유튜브 Data API v3 키를 입력하세요.</description>
        </var>
        <var id="channel_id">
            <type>text</type>
            <name xml:lang="ko">채널 ID</name>
            <description xml:lang="ko">동영상을 불러올 유튜브 채널의 ID(예: UCxxxxxxxxxx)를 입력하세요.</description>
        </var>
        <var id="max_results">
            <type>text</type>
            <name xml:lang="ko">출력 개수</name>
            <description xml:lang="ko">표시할 동영상의 개수를 입력하세요. (기본 5개)</description>
        </var>
    </extra_vars>
</widget>
