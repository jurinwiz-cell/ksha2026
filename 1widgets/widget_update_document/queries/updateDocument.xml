<query id="updateDocument" action="update" priority="LOW">
    <tables>
        <table name="documents" />
    </tables>
    <columns>
        <column name="is_notice" var="is_notice" default="N" notnull="notnull" />
        <column name="readed_count" var="readed_count" default="0" />
        <column name="voted_count" var="voted_count" default="0" />
        <column name="blamed_count" var="blamed_count" default="0" />
        <column name="regdate" var="regdate" notnull="notnull" />
        <column name="last_update" var="last_update" notnull="notnull" />
    </columns>
    <conditions>
        <condition operation="equal" column="document_srl" var="document_srl" filter="number" notnull="notnull" />
    </conditions>
</query>
