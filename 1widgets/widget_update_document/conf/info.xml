<?xml	version="1.0"	encoding="UTF-8"?>
<widget	version="0.2">
	<title xml:lang="ko">XENARA	문서정보 업데이트 위젯</title>
	<description xml:lang="ko">
		문서의 조회수,추천수 등 간단한 정보를 쉽게 수정할 수 있는 위젯입니다.
	</description>
	<version>0.1</version>
	<date>2016-07</date>

	<author	email_address="kolaskks@naver.com" link="http://xenara.zaggu.net">
		<name	xml:lang="ko">XENARA</name>
	</author>

	<extra_vars>
		<group>
			<title xml:lang="ko">목록설정</title>
			<var id="module_srls">
				<type>module_srl_list</type>
				<name	xml:lang="ko">대상모듈</name>
				<description xml:lang="ko">문서 수정을 적용할 모듈(게시판)을 등록하세요.</description>
			</var>
			<var id="sort_index" type="select">
				<name	xml:lang="ko">정렬대상</name>
				<description xml:lang="ko">정렬대상을	선택하세요.</description>
				<options>
					<value>regdate</value>
					<name	xml:lang="ko">등록순</name>
				</options>
				<options>
					<value>update_order</value>
					<name	xml:lang="ko">변경순</name>
				</options>
				<options>
					<value>readed_count</value>
					<name	xml:lang="ko">조회순</name>
				</options>
				<options>
					<value>voted_count</value>
					<name	xml:lang="ko">추천순</name>
				</options>
				<options>
					<value>blamed_count</value>
					<name	xml:lang="ko">비추천순</name>
				</options>
			</var>
			<var id="order_type" type="select">
				<name	xml:lang="ko">정렬방법</name>
				<description xml:lang="ko">정렬방법을	선택하세요.</description>
				<options>
					<value>desc</value>
					<name	xml:lang="ko">내림차순</name>
				</options>
				<options>
					<value>asc</value>
					<name	xml:lang="ko">올림차순</name>
				</options>
			</var>
			<var id="list_count" type="text">
				<name	xml:lang="ko">목록수</name>
				<description xml:lang="ko">목록수를	입력하세요. (기본: 20)</description>
			</var>
			<var id="page_count" type="text">
				<name	xml:lang="ko">페이지수</name>
				<description xml:lang="ko">페이지를	입력하세요. (기본: 10)</description>
			</var>
		</group>

		<group>
			<title xml:lang="ko">권한설정</title>
   		<var id="update_group" type="member_group">
   			 <name xml:lang="ko">수정그룹</name>
       	 <description xml:lang="ko">수정그룹을 선택하세요. 선택하지 않으면 모든 그룹을 대상으로 합니다.</description>
   		</var>
		</group>

		<group>
			<title xml:lang="ko">기타설정</title>
			<var id="subject_cut_size" type="text">
				<name	xml:lang="ko">제목 글자수</name>
				<description xml:lang="ko">제목 글자수를	입력하세요. 입력하지 않으면 자르지 않습니다.</description>
			</var>
		</group>
	</extra_vars>
</widget>
