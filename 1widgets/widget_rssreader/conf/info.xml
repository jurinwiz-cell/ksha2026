<?xml version="1.0" encoding="UTF-8"?>
<widget version="0.2">
    <title xml:lang="ko">XENARA RSS(2.0) READER 위젯</title>
    <description xml:lang="ko">RSS(2.0)을 출력하는 위젯입니다.</description>
    <version>1.8.25</version>
    <date>2016-10</date>

    <author email_address="kolaskks@naver.com" link="http://xenara.zaggu.net/">
        <name xml:lang="ko">XENARA</name>
    </author>

    <extra_vars>
        <group>
            <title xml:lang="ko">RSS 목록 설정</title>
            <var id="rss_url" type="text">
                <name xml:lang="ko">RSS(2.0) 주소(필수)</name>
                <description xml:lang="ko">RSS(2.0) 주소를 입력하세요.</description>
            </var>
            <var id="list_count" type="text">
                <name xml:lang="ko">목록수</name>
                <description xml:lang="ko">목록수를 입력하세요. 입력하지 않으면 전체목록을 출력합니다.</description>
            </var>
            <var id="subject_cut_size" type="text">
                <name xml:lang="ko">제목 글자수</name>
                <description xml:lang="ko">제목 글자수를 입력하세요. 입력하지 않으면 자르지 않습니다.</description>
            </var>
      			<var id="output_pubdate" type="select">
	        			<name xml:lang="ko">pubDate 출력유무</name>
		  		      <description xml:lang="ko">pubDate 출력유무를 출력유무를 선택하세요.</description>
                <options>
                    <value>Y</value>
                    <name xml:lang="ko">출력</name>
                </options>
                <options>
                    <value>N</value>
                    <name xml:lang="ko">출력안함</name>
                </options>
  		    	</var>
            <var id="pubdate_tail_cutsize" type="text">
                <name xml:lang="ko">pubDate 자름길이</name>
                <description xml:lang="ko">pubDate 자름길이를 입력하세요. 뒤에서 부터 입력한 숫자만큼 자릅니다. (기본 15)</description>
            </var>
        </group>

        <group>
            <title xml:lang="ko">기타 설정</title>
      			<var id="output_rsssearch" type="select">
	        			<name xml:lang="ko">RSS URL 검색필드 출력유무</name>
		  		      <description xml:lang="ko">RSS URL 검색필드 출력유무를 선택하세요. '출력'을 선택할 경우, RSS URL을 입력받아 출력할 수 있습니다.</description>
                <options>
                    <value>N</value>
                    <name xml:lang="ko">출력안함</name>
                </options>
                <options>
                    <value>Y</value>
                    <name xml:lang="ko">출력</name>
                </options>
  		    	</var>
            <var id="rss_title" type="text">
                <name xml:lang="ko">RSS 제목</name>
                <description xml:lang="ko">RSS 제목을 입력하세요. 입력하지 않으면 RSS에서 제공하는 제목을 출력합니다.</description>
            </var>
            <var id="rss_title_url" type="text">
                <name xml:lang="ko">RSS 제목 URL</name>
                <description xml:lang="ko">RSS 제목 URL을 입력하세요. 입력하지 않으면 RSS에서 제공하는 제목 URL을 출력합니다.</description>
            </var>
        </group>

    		<group>
    	  	  <title xml:lang="ko">문구 설정</title>
            <var id="text_rss_url" type="text">
                <name xml:lang="ko">'RSS URL' 문구</name>
      			    <description xml:lang="ko">'RSS URL' 문구를 입력하세요.</description>
            </var>
        </group>
    </extra_vars>
</widget>
