<?xml version="1.0" encoding="UTF-8"?>
<widget version="0.2">
	<title xml:lang="ko">배너 출력 위젯</title>
	<description xml:lang="ko">등록된 광고를 배너 형식으로 출력하는 위젯입니다.</description>
	<version>0.6</version>
	<date>2019-12-18</date>

	<author email_address="funnyxe@simplesoft.io" link="https://funnyxe.com">
		<name xml:lang="ko">퍼니XE</name>
	</author>
	<extra_vars>
		<var id="slider_width">
			<type>text</type>
			<name xml:lang="ko">슬라이더 가로폭</name>
			<description xml:lang="ko">단위를 포함한 숫자를 입력해주세요.
			예) 500px</description>
		</var>
		<var id="scroll_speed">
			<type>text</type>
				<name xml:lang="ko">스크롤 속도</name>
				<description xml:lang="ko">스크롤 되는 속도를 지정할 수 있습니다.
				(기본 : 50, 숫자가 작을 수록 빠릅니다)</description>
		</var>
		<var id="scroll_rate">
			<type>text</type>
				<name xml:lang="ko">스크롤 간격</name>
				<description xml:lang="ko">스크롤 간격을 지정할 수 있습니다.
				(기본 : 3500, 숫자가 작을 수록 빠릅니다)</description>
		</var>
		<var id="scroll_stop">
			<type>select</type>
				<name xml:lang="ko">마우스 올릴 시 스크롤 중단</name>
				<options>
					<value>Y</value>
					<name xml:lang="ko">사용</name>
				</options>
				<options>
					<value>N</value>
					<name xml:lang="ko">사용 안함</name>
				</options>
		</var>
		<var id="module_srls">
			<type>mid</type>
				<name xml:lang="ko">대상 모듈</name>
				<description xml:lang="ko">선택하신 모듈에 등록된 광고를 대상으로 합니다.
				(※ 반드시 선택해주세요!!)</description>
		</var>
	</extra_vars>
</widget>
