<?xml version="1.0" encoding="UTF-8"?>
<widget version="0.2">
	<title xml:lang="ko">웹콘 모자이크갤러리 위젯</title>
	<description xml:lang="ko">최근 문서를 모자이크갤러리 형태로 출력하는 위젯입니다.</description>
	<version>0.1</version>
	<date>2014-04-15</date>

	<author email_address="travelposts@naver.com" link="http://www.webconsoft.co.kr">
		<name xml:lang="ko">웹콘소프트</name>
	</author>

	<extra_vars>
		<var id="order_target">
			<type>select</type>
			<name xml:lang="ko">정렬 대상</name>
			<options>
				<value>list_order</value>
				<name xml:lang="ko">최신 등록순</name>
			</options>
			<options>
				<value>update_order</value>
				<name xml:lang="ko">최근 변경순</name>
			</options>
		</var>
		<var id="order_type">
			<type>select</type>
			<name xml:lang="ko">정렬 방법</name>
			<description xml:lang="ko">정렬대상을 내림차순 또는 올림차순으로 정렬할 수 있습니다.</description>
			<options>
				<value>desc</value>
				<name xml:lang="ko">내림차순</name>
			</options>
			<options>
				<value>asc</value>
				<name xml:lang="ko">올림차순</name>
			</options>
		</var>
		<var id="subject_cut_size">
			<type>text</type>
			<name xml:lang="ko">제목 글자수</name>
			<description xml:lang="ko">제목 글자수를 지정할 수 있습니다. (기본 40자)</description>
		</var>
		<var id="content_cut_size">
			<type>text</type>
			<name xml:lang="ko">내용 글자수</name>
			<description xml:lang="ko">내용 글자수를 지정할 수 있습니다. (기본 80자)</description>
		</var>
		<var id="thumbnail_type">
			<type>select</type>
			<name xml:lang="ko">썸네일 생성 방법</name>
			<description xml:lang="ko">썸네일 생성은 채우기만 가능합니다.(crop : 꽉 채우기)</description>
			<options>
				<value>crop</value>
				<name xml:lang="ko">Crop (채우기)</name>
			</options>
		</var>
		<var id="thumbnail_size">
			<type>text</type>
			<name xml:lang="ko">정사각형 이미지 (가로x세로) 크기</name>
			<description xml:lang="ko">출력될 정사각형 이미지의 크기를 정하실 수 있습니다.(※50px이상) (기본 80px)</description>
		</var>
		
		<var id="list_count">
			<type>text</type>
			<name xml:lang="ko">모자이크 배열(가로x세로 목록수)</name>
			<description xml:lang="ko">출력될 목록수를 정하실 수 있습니다.(정사각형 최소 3x3 이상) (기본 4x4개)</description>
		</var>
		<var id="module_srls">
			<type>module_srl_list</type>
			<name xml:lang="ko">대상 모듈</name>
			<description xml:lang="ko">선택하신 모듈에 등록된 글을 대상으로 합니다.</description>
		</var>
	</extra_vars>
</widget>
