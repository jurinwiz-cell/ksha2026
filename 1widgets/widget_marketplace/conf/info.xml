<?xml version="1.0" encoding="UTF-8"?>
<widget version="0.2">
    <title xml:lang="ko">XENARA 마켓플레이스 위젯</title>
    <description xml:lang="ko">마켓플레이스의 상품을 출력하는 위젯입니다.</description>
    <version>0.1.1</version>
    <date>2015-02</date>

    <author email_address="kolaskks@naver.com" link="http://xenara.co.kr/">
        <name xml:lang="ko">XENARA</name>
    </author>

    <extra_vars>
        <group>
            <title xml:lang="ko">목록 설정</title>
            <var id="module_srls">
                <type>module_srl_list</type>
                <name xml:lang="ko">대상모듈</name>
                <description xml:lang="ko">선택하신 모듈(marketplace)에 등록된 글을 대상으로 합니다.</description>
            </var>
            <var id="category_srls" type="text">
                <name xml:lang="ko">분류번호</name>
                <description xml:lang="ko">분류번호를 입력하세요. 입력한 번호의 분류만 출력합니다. 여러개일 경우 콤마(,)로 구분하여 입력하세요.</description>
            </var>
            <var id="item_status" type="select">
                <name xml:lang="ko">상품상태</name>
                <description xml:lang="ko">상품상태를 선택하세요. 선택한 상태의 상품만 출력합니다.</description>
                <options>
                    <value></value>
                    <name xml:lang="ko">모든상품</name>
                </options>
                <options>
                    <value>selling</value>
                    <name xml:lang="ko">판매중</name>
                </options>
                <options>
                    <value>soldout</value>
                    <name xml:lang="ko">판매완료</name>
                </options>
                <options>
                    <value>cancel</value>
                    <name xml:lang="ko">판매중단</name>
                </options>
            </var>
            <var id="list_count" type="text">
                <name xml:lang="ko">목록수</name>
                <description xml:lang="ko">출력될 목록의 수를 입력하세요.(기본: 20)</description>
            </var>
            <var id="order_target" type="select">
                <name xml:lang="ko">정렬대상</name>
                <description xml:lang="ko">등록된 순서 또는 변경된 순서로 정렬을 할 수 있습니다.</description>
                <options>
                    <value>regdate</value>
                    <name xml:lang="ko">등록순</name>
                </options>
                <options>
                    <value>update_order</value>
                    <name xml:lang="ko">변경순</name>
                </options>
                <options>
                    <value>readed_count</value>
                    <name xml:lang="ko">조회순</name>
                </options>
                <options>
                    <value>product_name</value>
                    <name xml:lang="ko">상품명순</name>
                </options>
                <options>
                    <value>price</value>
                    <name xml:lang="ko">가격순</name>
                </options>
            </var>
            <var id="order_type" type="select">
                <name xml:lang="ko">정렬방법</name>
                <description xml:lang="ko">정렬대상을 내림차순 또는 올림차순으로 정렬할 수 있습니다.</description>
                <options>
                    <value>desc</value>
                    <name xml:lang="ko">내림차순</name>
                </options>
                <options>
                    <value>asc</value>
                    <name xml:lang="ko">올림차순</name>
                </options>
            </var>
            <var id="shuffle_type" type="select">
                <name xml:lang="ko">무작위 정렬유무</name>
                <description xml:lang="ko">무작위 정렬유무를 선택하세요. 목록이 무작위로 정렬됩니다.</description>
                <options>
                    <value>N</value>
                    <name xml:lang="ko">무작위 정렬 안함</name>
                </options>
                <options>
                    <value>Y</value>
                    <name xml:lang="ko">무작위 정렬</name>
                </options>
            </var>
        </group>


        <group>
            <title xml:lang="ko">제목내용 설정</title>
            <var id="subject_cut_size" type="text">
                <name xml:lang="ko">제목 글자수</name>
                <description xml:lang="ko">제목 글자수를 입력하세요. (0 또는 입력하지 않을 경우 자르지 않습니다.)</description>
            </var>
            <var id="content_cut_size" type="text">
                <name xml:lang="ko">내용 글자수</name>
                <description xml:lang="ko">내용 글자수를 입력하세요. (기본: 50)</description>
            </var>
        </group>


        <group>
            <title xml:lang="ko">썸네일 설정</title>
            <var id="thumbnail_width" type="text">
                <name xml:lang="ko">썸네일 가로크기</name>
                <description xml:lang="ko">썸네일 가로크기를 입력하세요. (기본: 100)</description>
            </var>
            <var id="thumbnail_height" type="text">
                <name xml:lang="ko">썸네일 세로크기</name>
                <description xml:lang="ko">썸네일 세로크기를 입력하세요. (기본: 100)</description>
            </var>
            <var id="thumbnail_type" type="select">
                <name xml:lang="ko">썸네일 생성 방법</name>
                <description xml:lang="ko">썸네일 생성 방법을 선택하세요. (Crop: 꽉 채우기, Ratio: 비율 맞추기)</description>
                <options>
                    <value>crop</value>
                    <name xml:lang="ko">Crop</name>
                </options>
                <options>
                    <value>ratio</value>
                    <name xml:lang="ko">Ratio</name>
                </options>
            </var>
        </group>


        <group>
            <title xml:lang="ko">사용자정의 출력 설정</title>
            <var id="extra_show_type" type="select">
                <name xml:lang="ko">사용자정의 출력 타입</name>
                <description xml:lang="ko">사용자정의 출력 타입을 선택하세요. 선택출력일 경우 사용자정의이름(eid)을 아래 입력항목에 입력하세요.</description>
                <options>
                    <value>all</value>
                    <name xml:lang="ko">전체출력</name>
                </options>
                <options>
                    <value>select</value>
                    <name xml:lang="ko">선택출력</name>
                </options>
                <options>
                    <value>none</value>
                    <name xml:lang="ko">출력안함</name>
                </options>
            </var>
            <var id="extra_eid" type="text">
                <name xml:lang="ko">선택출력 사용자정의이름(eid)</name>
                <description xml:lang="ko">선택출력일 경우 사용자정의이름(eid)을 입력하세요. 여러개일 경우 콤마(,)로 구분하여 입력하세요.</description>
            </var>
        </group>


        <group>
            <title xml:lang="ko">기타 설정</title>
            <var id="new_window" type="select">
                <name xml:lang="ko">링크타겟</name>
                <description xml:lang="ko">링크타겟을 선택하세요.</description>
        				<options>
					          <value>_self</value>
        					  <name xml:lang="ko">현재창에서 열기</name>
        				</options>
				        <options>
        					  <value>_blank</value>
				        	  <name xml:lang="ko">새창에서 열기</name>
        				</options>
            </var>
            <var id="duration_new" type="text">
                <name xml:lang="ko">new 표시시간</name>
                <description xml:lang="ko">새로 등록된 게시물의 new 표시시간을 입력하세요. (기본: 12)</description>
            </var>
            <var id="date_format" type="text">
                <name xml:lang="ko">일자형식</name>
                <description xml:lang="ko">php date()의 일자형식을 입력하세요. 반드시 따옴표와 같이 입력하세요. (기본: 'Y.m.d')</description>
            </var>
        </group>


        <group>
            <title xml:lang="ko">문구 설정</title>
            <var id="won_format_text" type="text">
                <name xml:lang="ko">원단위 문구</name>
                <description xml:lang="ko">원단위 문구를 입력하세요. (기본: 원)</description>
            </var>
            <var id="product_price_text" type="text">
                <name xml:lang="ko">상품가격 문구</name>
                <description xml:lang="ko">상품가격 문구를 입력하세요. (기본: 상품가격)</description>
            </var>
            <var id="product_soldout_text" type="text">
                <name xml:lang="ko">판매완료 문구</name>
                <description xml:lang="ko">판매완료 문구를 입력하세요. (기본: 판매완료)</description>
            </var>
            <var id="product_cancel_text" type="text">
                <name xml:lang="ko">판매중단 문구</name>
                <description xml:lang="ko">판매중단 문구를 입력하세요. (기본: 판매중단)</description>
            </var>
            <var id="product_selling_text" type="text">
                <name xml:lang="ko">판매중 문구</name>
                <description xml:lang="ko">판매중 문구를 입력하세요. (기본: 판매중)</description>
            </var>
        </group>
    </extra_vars>
</widget>
