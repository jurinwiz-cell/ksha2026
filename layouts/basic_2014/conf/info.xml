<layout version="0.2">
    <title xml:lang="ko">Basic 2014</title>
    <title xml:lang="en">Basic 2014</title>
    <description xml:lang="ko">XE Contest 2014 Template A(Basic)를 라이믹스용으로 이식한 레이아웃</description>
    <description xml:lang="en">A Rhymix layout ported from XE Contest 2014 Template A (Basic)</description>
    <version>0.1.3</version>
    <date>2026-07-09</date>
    <author email_address="yjsoft@yjsoft.xyz">
        <name xml:lang="ko">YJSoft</name>
    </author>

    <menus>
        <menu name="GNB" maxdepth="3">
            <title xml:lang="ko">전역 네비게이션 바 (GNB)</title>
            <title xml:lang="en">Global Navigation Bar (GNB)</title>
        </menu>
        <menu name="FOOTER_MENU" maxdepth="2">
            <title xml:lang="ko">푸터 사이트맵 메뉴</title>
            <title xml:lang="en">Footer Sitemap Menu</title>
        </menu>
        <menu name="FOOTER_BOTTOM" maxdepth="1">
            <title xml:lang="ko">푸터 최하단 한 줄 메뉴</title>
            <title xml:lang="en">Footer Bottom Line Menu</title>
        </menu>
    </menus>

    <extra_vars>
        <group>
            <title xml:lang="ko">일반</title>
            <title xml:lang="en">General</title>
            <var name="LOGO_IMG" type="image">
                <title xml:lang="ko">헤더 로고 이미지</title>
                <title xml:lang="en">Header logo image</title>
            </var>
            <var name="LOGO_TEXT" type="text">
                <title xml:lang="ko">헤더 로고 문자 (이미지 없을 때 대체)</title>
                <title xml:lang="en">Header logo text (used when no image is set)</title>
            </var>
            <var name="LOGO_URL" type="text">
                <title xml:lang="ko">헤더 로고 연결 주소 (비우면 사이트 루트)</title>
                <title xml:lang="en">Header logo link URL (defaults to the site root if empty)</title>
            </var>
            <var name="WEB_FONT" type="select">
                <title xml:lang="ko">나눔고딕 웹폰트</title>
                <title xml:lang="en">NanumGothic web font</title>
                <options value="N">
                    <title xml:lang="ko">사용 안 함</title>
                    <title xml:lang="en">Do not use</title>
                </options>
                <options value="Y">
                    <title xml:lang="ko">사용</title>
                    <title xml:lang="en">Use</title>
                </options>
            </var>
            <var name="colorset" type="select">
                <title xml:lang="ko">컬러 테마</title>
                <title xml:lang="en">Color theme</title>
                <options value="">
                    <title xml:lang="ko">Royal Classic (기본)</title>
                    <title xml:lang="en">Royal Classic (default)</title>
                </options>
                <options value="color_grape_fruit">
                    <title xml:lang="ko">Grape Fruit</title>
                    <title xml:lang="en">Grape Fruit</title>
                </options>
                <options value="color_hot_pink">
                    <title xml:lang="ko">Hot Pink</title>
                    <title xml:lang="en">Hot Pink</title>
                </options>
                <options value="color_orchid">
                    <title xml:lang="ko">Orchid</title>
                    <title xml:lang="en">Orchid</title>
                </options>
                <options value="color_blue_jeans">
                    <title xml:lang="ko">Blue Jeans</title>
                    <title xml:lang="en">Blue Jeans</title>
                </options>
                <options value="color_mint">
                    <title xml:lang="ko">Mint</title>
                    <title xml:lang="en">Mint</title>
                </options>
                <options value="color_sunflower">
                    <title xml:lang="ko">Sunflower</title>
                    <title xml:lang="en">Sunflower</title>
                </options>
                <options value="color_bitter_sweet">
                    <title xml:lang="ko">Bitter Sweet</title>
                    <title xml:lang="en">Bitter Sweet</title>
                </options>
                <options value="color_java_coffee">
                    <title xml:lang="ko">Java Coffee</title>
                    <title xml:lang="en">Java Coffee</title>
                </options>
                <options value="color_gray">
                    <title xml:lang="ko">Gray</title>
                    <title xml:lang="en">Gray</title>
                </options>
            </var>
            <var name="COLORSET_DEMO_USE" type="select">
                <title xml:lang="ko">컬러테마 변경 메뉴 사용 (데모)</title>
                <title xml:lang="en">Enable color theme switcher menu (demo)</title>
                <options value="N">
                    <title xml:lang="ko">사용 안 함</title>
                    <title xml:lang="en">Do not use</title>
                </options>
                <options value="Y">
                    <title xml:lang="ko">사용 (GNB 마지막에 컬러테마 변경 메뉴 추가, 선택값은 쿠키에 저장)</title>
                    <title xml:lang="en">Use (adds a color theme menu at the end of the GNB; the choice is stored in a cookie)</title>
                </options>
            </var>
        </group>

        <group>
            <title xml:lang="ko">레이아웃 구성</title>
            <title xml:lang="en">Layout composition</title>
            <var name="COLUMN_TYPE" type="select">
                <title xml:lang="ko">컬럼 구성</title>
                <title xml:lang="en">Column layout</title>
                <options value="FULL">
                    <title xml:lang="ko">1단 (전체 컨텐츠)</title>
                    <title xml:lang="en">1 column (full content)</title>
                </options>
                <options value="LEFT">
                    <title xml:lang="ko">2단 (좌측 LNB)</title>
                    <title xml:lang="en">2 columns (LNB on the left)</title>
                </options>
                <options value="RIGHT">
                    <title xml:lang="ko">2단 (우측 LNB)</title>
                    <title xml:lang="en">2 columns (LNB on the right)</title>
                </options>
            </var>

            <var name="PAGE_TYPE" type="select">
                <title xml:lang="ko">페이지 유형</title>
                <title xml:lang="en">Page type</title>
                <options value="MAIN">
                    <title xml:lang="ko">메인 (비주얼 슬라이더)</title>
                    <title xml:lang="en">Main (visual slider)</title>
                </options>
                <options value="SUB">
                    <title xml:lang="ko">서브 (빵조각/브레드크럼)</title>
                    <title xml:lang="en">Sub (breadcrumb)</title>
                </options>
            </var>

            <var name="LNB_TOP_IMAGE_USE" type="select">
                <title xml:lang="ko">LNB 상단 썸네일 이미지 사용</title>
                <title xml:lang="en">Use LNB top thumbnail image</title>
                <options value="N">
                    <title xml:lang="ko">사용 안 함</title>
                    <title xml:lang="en">Do not use</title>
                </options>
                <options value="Y">
                    <title xml:lang="ko">사용</title>
                    <title xml:lang="en">Use</title>
                </options>
            </var>
            <var name="LNB_TOP_IMAGE" type="image">
                <title xml:lang="ko">LNB 상단 썸네일 이미지</title>
                <title xml:lang="en">LNB top thumbnail image</title>
            </var>
        </group>

        <group>
            <title xml:lang="ko">메인 비주얼 슬라이더</title>
            <title xml:lang="en">Main visual slider</title>
            <var name="VISUAL_IMAGE_1" type="image">
                <title xml:lang="ko">메인 비주얼 슬라이드 1 이미지 (비우면 기본 이미지)</title>
                <title xml:lang="en">Main visual slide 1 image (default image used if empty)</title>
            </var>
            <var name="VISUAL_TITLE_1" type="text">
                <title xml:lang="ko">메인 비주얼 슬라이드 1 제목</title>
                <title xml:lang="en">Main visual slide 1 title</title>
            </var>
            <var name="VISUAL_DESC_1" type="text">
                <title xml:lang="ko">메인 비주얼 슬라이드 1 설명</title>
                <title xml:lang="en">Main visual slide 1 description</title>
            </var>
            <var name="VISUAL_IMAGE_2" type="image">
                <title xml:lang="ko">메인 비주얼 슬라이드 2 이미지 (비우면 기본 이미지)</title>
                <title xml:lang="en">Main visual slide 2 image (default image used if empty)</title>
            </var>
            <var name="VISUAL_TITLE_2" type="text">
                <title xml:lang="ko">메인 비주얼 슬라이드 2 제목</title>
                <title xml:lang="en">Main visual slide 2 title</title>
            </var>
            <var name="VISUAL_DESC_2" type="text">
                <title xml:lang="ko">메인 비주얼 슬라이드 2 설명</title>
                <title xml:lang="en">Main visual slide 2 description</title>
            </var>
            <var name="VISUAL_IMAGE_3" type="image">
                <title xml:lang="ko">메인 비주얼 슬라이드 3 이미지 (비우면 기본 이미지)</title>
                <title xml:lang="en">Main visual slide 3 image (default image used if empty)</title>
            </var>
            <var name="VISUAL_TITLE_3" type="text">
                <title xml:lang="ko">메인 비주얼 슬라이드 3 제목</title>
                <title xml:lang="en">Main visual slide 3 title</title>
            </var>
            <var name="VISUAL_DESC_3" type="text">
                <title xml:lang="ko">메인 비주얼 슬라이드 3 설명</title>
                <title xml:lang="en">Main visual slide 3 description</title>
            </var>
            <var name="VISUAL_IMAGE_4" type="image">
                <title xml:lang="ko">메인 비주얼 슬라이드 4 이미지 (비우면 기본 이미지)</title>
                <title xml:lang="en">Main visual slide 4 image (default image used if empty)</title>
            </var>
            <var name="VISUAL_TITLE_4" type="text">
                <title xml:lang="ko">메인 비주얼 슬라이드 4 제목</title>
                <title xml:lang="en">Main visual slide 4 title</title>
            </var>
            <var name="VISUAL_DESC_4" type="text">
                <title xml:lang="ko">메인 비주얼 슬라이드 4 설명</title>
                <title xml:lang="en">Main visual slide 4 description</title>
            </var>
        </group>

        <group>
            <title xml:lang="ko">서브 페이지 비주얼</title>
            <title xml:lang="en">Sub-page visual</title>
            <var name="SUB_VISUAL_BG_USE" type="select">
                <title xml:lang="ko">서브 페이지 빵조각 배경이미지 사용</title>
                <title xml:lang="en">Use background image for the sub-page breadcrumb</title>
                <options value="N">
                    <title xml:lang="ko">사용 안 함</title>
                    <title xml:lang="en">Do not use</title>
                </options>
                <options value="Y">
                    <title xml:lang="ko">사용</title>
                    <title xml:lang="en">Use</title>
                </options>
            </var>
            <var name="SUB_VISUAL_BG_IMAGE" type="image">
                <title xml:lang="ko">서브 페이지 빵조각 배경이미지</title>
                <title xml:lang="en">Sub-page breadcrumb background image</title>
            </var>
        </group>

        <group>
            <title xml:lang="ko">로그인</title>
            <title xml:lang="en">Login</title>
            <var name="LOGIN_MODAL_USE" type="select">
                <title xml:lang="ko">로그인 모달 사용</title>
                <title xml:lang="en">Use login modal</title>
                <options value="N">
                    <title xml:lang="ko">사용 안 함 (로그인 페이지로 이동)</title>
                    <title xml:lang="en">Do not use (navigate to the login page)</title>
                </options>
                <options value="Y">
                    <title xml:lang="ko">사용 (페이지 위에 모달로 표시)</title>
                    <title xml:lang="en">Use (show as an overlay modal)</title>
                </options>
            </var>
            <var name="LOGIN_MODAL_LOGO_IMG" type="image">
                <title xml:lang="ko">로그인 모달 상단 로고 이미지 (비우면 기본 XE 로고)</title>
                <title xml:lang="en">Login modal header logo image (default XE logo if empty)</title>
            </var>
        </group>

        <group>
            <title xml:lang="ko">푸터</title>
            <title xml:lang="en">Footer</title>
            <var name="FOOTER_LOGO_IMG" type="image">
                <title xml:lang="ko">푸터 로고 이미지</title>
                <title xml:lang="en">Footer logo image</title>
            </var>
            <var name="FOOTER_LOGO_TEXT" type="text">
                <title xml:lang="ko">푸터 로고 문자 (이미지 없을 때 대체)</title>
                <title xml:lang="en">Footer logo text (used when no image is set)</title>
            </var>
            <var name="FOOTER_LOGO_URL" type="text">
                <title xml:lang="ko">푸터 로고 연결 주소 (비우면 사이트 루트)</title>
                <title xml:lang="en">Footer logo link URL (defaults to the site root if empty)</title>
            </var>
            <var name="FOOTER_SITE_NAME" type="text">
                <title xml:lang="ko">푸터 사이트명 문구</title>
                <title xml:lang="en">Footer site name text</title>
            </var>
            <var name="FOOTER_SITE_URL" type="text">
                <title xml:lang="ko">푸터 사이트명에 연결할 링크</title>
                <title xml:lang="en">Link for the footer site name</title>
            </var>
            <var name="FOOTER_COPYRIGHT" type="textarea">
                <title xml:lang="ko">푸터 최하단 저작권 문구 (링크 등 HTML 허용)</title>
                <title xml:lang="en">Footer copyright text (HTML such as links is allowed)</title>
            </var>
        </group>

        <group>
            <title xml:lang="ko">SNS 링크</title>
            <title xml:lang="en">SNS links</title>
            <var name="SNS_FACEBOOK_URL" type="text">
                <title xml:lang="ko">Facebook 링크 (비우면 아이콘 숨김)</title>
                <title xml:lang="en">Facebook URL (leave empty to hide the icon)</title>
            </var>
            <var name="SNS_TWITTER_URL" type="text">
                <title xml:lang="ko">Twitter(X) 링크 (비우면 아이콘 숨김)</title>
                <title xml:lang="en">Twitter(X) URL (leave empty to hide the icon)</title>
            </var>
            <var name="SNS_LINKEDIN_URL" type="text">
                <title xml:lang="ko">LinkedIn 링크 (비우면 아이콘 숨김)</title>
                <title xml:lang="en">LinkedIn URL (leave empty to hide the icon)</title>
            </var>
            <var name="SNS_GITHUB_URL" type="text">
                <title xml:lang="ko">GitHub 링크 (비우면 아이콘 숨김)</title>
                <title xml:lang="en">GitHub URL (leave empty to hide the icon)</title>
            </var>
            <var name="SNS_RSS_URL" type="text">
                <title xml:lang="ko">RSS 피드 링크 (비우면 아이콘 숨김)</title>
                <title xml:lang="en">RSS feed URL (leave empty to hide the icon)</title>
            </var>
            <var name="SNS_YOUTUBE_URL" type="text">
                <title xml:lang="ko">YouTube 링크 (비우면 아이콘 숨김, 원본 Google+ 대체)</title>
                <title xml:lang="en">YouTube URL (leave empty to hide the icon; replaces the original Google+ icon)</title>
            </var>
        </group>
    </extra_vars>
</layout>
