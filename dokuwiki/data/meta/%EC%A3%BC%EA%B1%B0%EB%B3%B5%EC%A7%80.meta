1. 정의

주거복지는 모든 국민이 쾌적하고 안정적인 주거 환경에서 인간다운 주거 생활을 누릴 수 있도록 국가나 지자체, 시민사회 등이 제공하는 사회적 지원과 정책을 통틀어 말합니다.";}s:8:"relation";a:2:{s:10:"references";a:2:{s:18:"공공임대주택";b:1;s:12:"사회주택";b:1;}s:10:"firstimage";s:0:"";}s:8:"internal";a:2:{s:5:"cache";b:1;s:3:"toc";b:1;}}s:10:"persistent";a:4:{s:4:"date";a:1:{s:7:"created";i:1785506355;}s:7:"creator";s:10:"ksha green";s:4:"user";s:5:"admin";s:11:"last_change";a:9:{s:4:"date";i:1785506355;s:2:"ip";s:15:"211.106.175.173";s:4:"type";s:1:"C";s:2:"id";s:12:"주거복지";s:4:"user";s:5:"admin";s:3:"sum";s:6:"만듦";s:5:"extra";s:0:"";s:10:"sizechange";i:2498;s:4:"mode";s:4:"page";}}}