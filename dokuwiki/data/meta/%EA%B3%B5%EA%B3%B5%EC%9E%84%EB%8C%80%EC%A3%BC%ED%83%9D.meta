1. 정의

공공임대주택은 공공주택사업자(국가, 지방자치단체, 한국토지주택공사(LH), 지방공사 등)가 재정이나 주택도시기금을 지원받아 건설, 매입 또는 임차하여 공급하는 주택 중 임대 목적으로 제공하는 주택을 말합니다.";}s:8:"relation";a:2:{s:10:"references";a:2:{s:12:"사회주택";b:1;s:12:"주거복지";b:1;}s:10:"firstimage";s:0:"";}s:8:"internal";a:2:{s:5:"cache";b:1;s:3:"toc";b:1;}}s:10:"persistent";a:4:{s:4:"date";a:1:{s:7:"created";i:1785506181;}s:7:"creator";s:10:"ksha green";s:4:"user";s:5:"admin";s:11:"last_change";a:9:{s:4:"date";i:1785506181;s:2:"ip";s:15:"211.106.175.173";s:4:"type";s:1:"C";s:2:"id";s:18:"공공임대주택";s:4:"user";s:5:"admin";s:3:"sum";s:6:"만듦";s:5:"extra";s:0:"";s:10:"sizechange";i:2567;s:4:"mode";s:4:"page";}}}