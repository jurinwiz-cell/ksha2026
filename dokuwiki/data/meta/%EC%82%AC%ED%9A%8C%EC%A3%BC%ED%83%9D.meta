1. 정의

사회주택(Social Housing)은 사회적 경제 주체(비영리 단체, 협동조합, 사회적 기업 등)가 공급하고 운영하는 임대주택을 말합니다. 

취약계층이나 청년, 신혼부부 등 주거 안정이 필요한 이들에게 시장 가격(시세)보다 저렴한 임대료로 장기간 안정적인 거주 공간을 제공하는 것을 목적으로 합니다. 정부나 지자체가 직접 공급하는 공공임대주택과 개인이 수익을 목적으로 공급하는 민간임대주택의 중간 영역인…";}s:8:"relation";a:2:{s:10:"references";a:2:{s:18:"공공임대주택";b:1;s:12:"주거복지";b:1;}s:10:"firstimage";s:0:"";}s:8:"internal";a:2:{s:5:"cache";b:1;s:3:"toc";b:1;}}s:10:"persistent";a:4:{s:4:"date";a:1:{s:7:"created";i:1785506274;}s:7:"creator";s:10:"ksha green";s:4:"user";s:5:"admin";s:11:"last_change";a:9:{s:4:"date";i:1785506274;s:2:"ip";s:15:"211.106.175.173";s:4:"type";s:1:"C";s:2:"id";s:12:"사회주택";s:4:"user";s:5:"admin";s:3:"sum";s:6:"만듦";s:5:"extra";s:0:"";s:10:"sizechange";i:1836;s:4:"mode";s:4:"page";}}}