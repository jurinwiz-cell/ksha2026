<?xml version="1.0" encoding="UTF-8"?>
<widget version="0.2">
	<title>RXE 채팅 솔루션 - 위젯</title>
	<version>0.1</version>
	<date>2022-12-29</date>

	<author email_address="m@elkha.kr" link="http://elkha.kr/">
		<name>Elkha</name>
	</author>

	<extra_vars>
		<var id="chat_no" type="text">
			<name>room number</name>
			<description>1~255</description>
		</var>
		<var id="chat_title" type="text">
			<name>room name</name>
		</var>
		<var id="chat_width" type="text">
			<name>width (px, %)</name>
		</var>
		<var id="chat_height" type="text">
			<name>height (px, %)</name>
		</var>
		<var id="is_popup" type="select">
			<name>html tag</name>
			<options>
				<name>iframe</name>
				<value>N</value>
			</options>
			<options>
				<name>a</name>
				<value>a</value>
			</options>
		</var>
	</extra_vars>
</widget>
