<query id="getLogList" action="select">
	<tables>
		<table name="pullup_logs" />
		<table name="documents" type="left join">
			<conditions>
				<condition operation="equal" column="documents.document_srl" default="pullup_logs.document_srl" />
			</conditions>
		</table>
	</tables>
	<columns>
		<column name="pullup_logs.*" />
		<column name="documents.title" />
		<column name="documents.nick_name" />
	</columns>
	<conditions>
		<condition operation="equal" column="pullup_logs.module_srl" var="module_srl" />
	</conditions>
	<navigation>
		<index var="sort_index" default="pullup_logs.regdate" order="desc" />
		<list_count var="list_count" default="20" />
		<page_count var="page_count" default="10" />
		<page var="page" default="1" />
	</navigation>
</query>
