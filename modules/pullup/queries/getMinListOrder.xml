<query id="getMinListOrder" action="select">
	<tables>
		<table name="documents" />
	</tables>
	<columns>
		<column name="min(list_order)" alias="min_list_order" />
		<column name="min(update_order)" alias="min_update_order" />
	</columns>
	<conditions>
		<condition operation="equal" column="module_srl" var="module_srl" filter="number" notnull="notnull" />
	</conditions>
</query>
