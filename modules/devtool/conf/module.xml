<?xml version="1.0" encoding="utf-8"?>
<module>
	<grants>
	</grants>
	<actions>
		<!-- 관리자 액션 -->
		<action name="dispDevtoolAdminConfig" class="Controllers\Admin" menu-name="devtool" admin-index="true" />
		<action name="procDevtoolAdminInsertConfig" class="Controllers\Admin" />
		<!-- 메인 화면 예제 -->
		<action name="dispDevtoolIndex" class="Controllers\Index" index="true" permission="root" />
		<action name="dispDevtoolModuleIndex" class="Controllers\Module" route="modules" permission="root" />
		<action name="dispDevtoolModule" class="Controllers\Module" route="module/$target_module" permission="root" />
		<action name="dispDevtoolModuleInfo" class="Controllers\Module" route="module/$target_module/info" permission="root" />
		<action name="procDevtoolModuleInfoSave" class="Controllers\Module" permission="root" />
		<action name="procDevtoolModuleDownload" class="Controllers\Module" method="GET|POST" permission="root" />

		<action name="dispDevtoolSchema" class="Controllers\Schema" route="module/$target_module/schema/$schema_name" permission="root" />
		<action name="procDevtoolSchemaUpdate" class="Controllers\Schema" permission="root" />
		<action name="procDevtoolSchemaDelete" class="Controllers\Schema" permission="root" />
