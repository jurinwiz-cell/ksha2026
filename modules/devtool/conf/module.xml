		<action name="procDevtoolQueryDelete" class="Controllers\Query" permission="root" />
		<action name="getDevtoolQueryExecute" class="Controllers\Query" permission="root" />
		<action name="getDevtoolModelClasses" class="Controllers\Query" permission="root" />
		<action name="getDevtoolQueryPhp" class="Controllers\Query" permission="root" />
		<action name="procDevtoolQueryPhpSave" class="Controllers\Query" permission="root" />
