	<!-- 이벤트 핸들러 (트리거) 선언 -->
	<eventHandlers>
	</eventHandlers>
	<menus>
		<menu name="devtool" type="all">
			<title xml:lang="ko">개발자도구</title>
		</menu>
	</menus>
