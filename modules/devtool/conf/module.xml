		<action name="dispDevtoolAction" class="Controllers\Action" route="module/$target_module/action/$action_name" permission="root" />
		<action name="procDevtoolActionUpdate" class="Controllers\Action" permission="root" />
		<action name="procDevtoolActionDelete" class="Controllers\Action" permission="root" />
		<action name="getDevtoolActionClass" class="Controllers\Action" permission="root" />
		<action name="procDevtoolActionClassSave" class="Controllers\Action" permission="root" />

		<action name="dispDevtoolQuery" class="Controllers\Query" route="module/$target_module/query/$query_id" permission="root" />
		<action name="getDevtoolQuery" class="Controllers\Query" permission="root" />
		<action name="getDevtoolSchemaColumns" class="Controllers\Query" permission="root" />
