<table name="ddggshop_review">
  <column name="review_srl" type="bignumber" notnull="notnull" primary_key="primary_key" />
  <column name="item_srl" type="bignumber" notnull="notnull" index="idx_item" />
  <column name="member_srl" type="bignumber" default="0" index="idx_member" />
  <column name="member_name" type="varchar" size="100" />
  <column name="rating" type="number" default="5" notnull="notnull" />
  <column name="content" type="text" />
  <column name="status" type="char" size="1" default="Y" notnull="notnull" />
  <column name="regdate" type="date" index="idx_regdate" />
</table>
