  <column name="actor_name" type="varchar" size="100" />
  <column name="action" type="varchar" size="30" />
  <column name="from_status" type="varchar" size="20" />
  <column name="to_status" type="varchar" size="20" />
  <column name="memo" type="varchar" size="255" />
  <column name="regdate" type="datetime" index="idx_regdate" />
</table>
