<table name="ddggshop_item">
  <column name="item_srl" type="bignumber" notnull="notnull" primary_key="primary_key" />
  <column name="category_srl" type="bignumber" default="0" index="idx_category" />
  <column name="item_name" type="varchar" size="250" notnull="notnull" />
  <column name="item_code" type="varchar" size="100" index="idx_item_code" />
  <column name="price" type="number" default="0" notnull="notnull" />
  <column name="cost_price" type="number" default="0" notnull="notnull" />
  <column name="stock" type="number" default="0" notnull="notnull" />
  <column name="use_stock" type="char" size="1" default="Y" notnull="notnull" />
  <column name="buy_limit" type="number" default="0" notnull="notnull" />
  <column name="grant_group" type="char" size="1" default="N" notnull="notnull" />
  <column name="grant_add_groups" type="varchar" size="255" />
  <column name="grant_del_groups" type="varchar" size="255" />
  <column name="summary" type="varchar" size="250" />
  <column name="content" type="text" />
  <column name="thumb" type="varchar" size="250" />
  <column name="images" type="text" />
  <column name="brand" type="varchar" size="100" />
  <column name="manufacturer" type="varchar" size="100" />
  <column name="origin" type="varchar" size="100" />
  <column name="attributes" type="text" />
  <column name="has_options" type="char" size="1" default="N" notnull="notnull" />
  <column name="option_groups" type="text" />
  <column name="ship_fee_type" type="varchar" size="10" default="default" />
  <column name="ship_fee" type="number" default="0" />
  <column name="require_address" type="char" size="1" default="Y" notnull="notnull" />
  <column name="point_rate" type="number" default="-1" notnull="notnull" />
  <column name="delivery_fee_type" type="char" size="1" default="F" notnull="notnull" />
  <column name="status" type="varchar" size="20" default="sale" notnull="notnull" index="idx_status" />
  <column name="is_recommend" type="char" size="1" default="N" notnull="notnull" index="idx_recommend" />
  <column name="is_new" type="char" size="1" default="N" notnull="notnull" />
  <column name="view_count" type="number" default="0" notnull="notnull" />
  <column name="buy_count" type="number" default="0" notnull="notnull" />
  <column name="list_order" type="bignumber" notnull="notnull" index="idx_list_order" />
  <column name="member_srl" type="bignumber" default="0" />
  <column name="regdate" type="date" index="idx_regdate" />
  <column name="last_update" type="date" />
</table>
