<query id="getCartItem" action="select">
  <tables>
    <table name="ddggshop_cart" />
  </tables>
  <columns>
    <column name="*" />
  </columns>
  <conditions>
    <condition operation="equal" column="member_srl" var="member_srl" />
    <condition operation="equal" column="session_key" var="session_key" />
    <condition operation="equal" column="item_srl" var="item_srl" notnull="notnull" />
    <condition operation="equal" column="option_srl" var="option_srl" />
  </conditions>
</query>
