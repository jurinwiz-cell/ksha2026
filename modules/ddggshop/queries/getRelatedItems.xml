<query id="getRelatedItems" action="select">
  <tables>
    <table name="ddggshop_item" />
  </tables>
  <columns>
    <column name="ddggshop_item.*" />
  </columns>
  <conditions>
    <condition operation="equal" column="category_srl" var="category_srl" notnull="notnull" />
    <condition operation="notequal" column="item_srl" var="item_srl" notnull="notnull" pipe="and" />
    <condition operation="equal" column="status" var="status" pipe="and" />
  </conditions>
  <navigation>
    <index var="sort_index" default="buy_count" order="desc" />
    <list_count var="list_count" default="8" />
  </navigation>
</query>
