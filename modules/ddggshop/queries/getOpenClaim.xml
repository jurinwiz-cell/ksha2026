<query id="getOpenClaim" action="select">
  <tables>
    <table name="ddggshop_claim" />
  </tables>
  <columns>
    <column name="*" />
  </columns>
  <conditions>
    <condition operation="equal" column="order_srl" var="order_srl" notnull="notnull" />
    <condition operation="notin" column="status" var="exclude_status" notnull="notnull" pipe="and" />
  </conditions>
  <navigation>
    <index var="sort_index" default="claim_srl" order="desc" />
    <list_count var="list_count" default="1" />
  </navigation>
</query>
