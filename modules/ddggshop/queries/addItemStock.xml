<query id="addItemStock" action="update">
  <tables>
    <table name="ddggshop_item" />
  </tables>
  <columns>
    <column name="stock" var="stock_delta" operation="plus" notnull="notnull" />
    <column name="buy_count" var="buy_count_delta" operation="plus" notnull="notnull" />
  </columns>
  <conditions>
    <condition operation="equal" column="item_srl" var="item_srl" notnull="notnull" />
  </conditions>
</query>
