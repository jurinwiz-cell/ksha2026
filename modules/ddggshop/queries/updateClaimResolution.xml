<query id="updateClaimResolution" action="update">
  <tables>
    <table name="ddggshop_claim" />
  </tables>
  <columns>
    <column name="type" var="type" notnull="notnull" />
    <column name="status" var="status" notnull="notnull" />
    <column name="refund_amount" var="refund_amount" />
    <column name="admin_memo" var="admin_memo" />
    <column name="processed_date" var="processed_date" />
  </columns>
  <conditions>
    <condition operation="equal" column="claim_srl" var="claim_srl" notnull="notnull" />
  </conditions>
</query>
