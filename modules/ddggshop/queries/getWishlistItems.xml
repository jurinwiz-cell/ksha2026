<query id="getWishlistItems" action="select">
  <tables>
    <table name="ddggshop_wishlist" />
    <table name="ddggshop_item" />
  </tables>
  <columns>
    <column name="ddggshop_item.*" />
    <column name="ddggshop_wishlist.wish_srl" />
    <column name="ddggshop_wishlist.regdate" alias="wish_date" />
  </columns>
  <conditions>
    <condition operation="equal" column="ddggshop_item.item_srl" default="ddggshop_wishlist.item_srl" />
    <condition operation="equal" column="ddggshop_wishlist.member_srl" var="member_srl" notnull="notnull" pipe="and" />
  </conditions>
  <navigation>
    <index var="sort_index" default="ddggshop_wishlist.wish_srl" order="desc" />
    <list_count var="list_count" default="24" />
    <page var="page" default="1" />
  </navigation>
</query>
