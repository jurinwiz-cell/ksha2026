<query id="getCouponMemberUseCount" action="select">
  <tables><table name="ddggshop_coupon_log" /></tables>
  <columns><column name="count(*)" alias="cnt" /></columns>
  <conditions>
    <condition operation="equal" column="coupon_srl" var="coupon_srl" notnull="notnull" />
    <condition operation="equal" column="member_srl" var="member_srl" notnull="notnull" />
  </conditions>
</query>
