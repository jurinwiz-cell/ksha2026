<query id="insertOrderLog" action="insert">
  <tables>
    <table name="ddggshop_order_log" />
  </tables>
  <columns>
    <column name="log_srl" var="log_srl" notnull="notnull" />
    <column name="order_srl" var="order_srl" notnull="notnull" />
    <column name="actor_srl" var="actor_srl" default="0" />
    <column name="actor_name" var="actor_name" />
    <column name="action" var="action" />
    <column name="from_status" var="from_status" />
    <column name="to_status" var="to_status" />
    <column name="memo" var="memo" />
    <column name="regdate" var="regdate" default="curdate()" />
  </columns>
</query>
