<query id="getItemTags" action="select">
  <tables>
    <table name="ddggshop_item_tag" />
    <table name="ddggshop_tag" />
  </tables>
  <columns>
    <column name="ddggshop_tag.tag_srl" />
    <column name="ddggshop_tag.title" />
    <column name="ddggshop_tag.badge_color" />
    <column name="ddggshop_tag.show_badge" />
    <column name="ddggshop_tag.list_order" />
  </columns>
  <conditions>
    <condition operation="equal" column="ddggshop_tag.tag_srl" default="ddggshop_item_tag.tag_srl" />
    <condition operation="equal" column="ddggshop_item_tag.item_srl" var="item_srl" notnull="notnull" pipe="and" />
  </conditions>
  <navigation>
    <index var="sort_index" default="ddggshop_tag.list_order" order="asc" />
  </navigation>
</query>
