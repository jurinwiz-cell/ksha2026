<query id="insertCategory" action="insert">
  <tables>
    <table name="ddggshop_category" />
  </tables>
  <columns>
    <column name="category_srl" var="category_srl" notnull="notnull" />
    <column name="parent_srl" var="parent_srl" default="0" />
    <column name="category_name" var="category_name" notnull="notnull" />
    <column name="name_i18n" var="name_i18n" />
    <column name="depth" var="depth" default="0" />
    <column name="list_order" var="list_order" notnull="notnull" />
    <column name="item_count" var="item_count" default="0" />
    <column name="status" var="status" default="Y" />
    <column name="regdate" var="regdate" default="curdate()" />
  </columns>
</query>
