<query id="insertReview" action="insert">
  <tables>
    <table name="ddggshop_review" />
  </tables>
  <columns>
    <column name="review_srl" var="review_srl" notnull="notnull" />
    <column name="item_srl" var="item_srl" notnull="notnull" />
    <column name="member_srl" var="member_srl" default="0" />
    <column name="member_name" var="member_name" />
    <column name="rating" var="rating" default="5" />
    <column name="content" var="content" />
    <column name="images" var="images" />
    <column name="point_given" var="point_given" default="N" />
    <column name="status" var="status" default="Y" />
    <column name="regdate" var="regdate" default="curdate()" />
  </columns>
</query>
