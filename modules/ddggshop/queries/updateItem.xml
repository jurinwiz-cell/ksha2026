<query id="updateItem" action="update">
  <tables>
    <table name="ddggshop_item" />
  </tables>
  <columns>
    <column name="category_srl" var="category_srl" default="0" />
    <column name="item_name" var="item_name" notnull="notnull" />
    <column name="item_code" var="item_code" />
    <column name="price" var="price" default="0" />
    <column name="cost_price" var="cost_price" default="0" />
    <column name="stock" var="stock" default="0" />
    <column name="use_stock" var="use_stock" default="Y" />
    <column name="buy_limit" var="buy_limit" default="0" />
    <column name="grant_group" var="grant_group" default="N" />
    <column name="grant_add_groups" var="grant_add_groups" />
    <column name="grant_del_groups" var="grant_del_groups" />
    <column name="summary" var="summary" />
    <column name="content" var="content" />
    <column name="thumb" var="thumb" />
    <column name="images" var="images" />
    <column name="brand" var="brand" />
    <column name="manufacturer" var="manufacturer" />
    <column name="origin" var="origin" />
    <column name="attributes" var="attributes" />
    <column name="has_options" var="has_options" default="N" />
    <column name="option_groups" var="option_groups" />
    <column name="ship_fee_type" var="ship_fee_type" default="default" />
    <column name="ship_fee" var="ship_fee" default="0" />
    <column name="require_address" var="require_address" default="Y" />
    <column name="point_rate" var="point_rate" default="-1" />
    <column name="delivery_fee_type" var="delivery_fee_type" default="F" />
    <column name="status" var="status" default="sale" />
    <column name="is_recommend" var="is_recommend" default="N" />
    <column name="is_new" var="is_new" default="N" />
    <column name="last_update" var="last_update" default="curdate()" />
    <column name="list_order" var="list_order" />
  </columns>
  <conditions>
    <condition operation="equal" column="item_srl" var="item_srl" notnull="notnull" />
  </conditions>
</query>
