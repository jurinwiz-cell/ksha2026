<query id="updateOrderPayment" action="update">
  <tables>
    <table name="ddggshop_order" />
  </tables>
  <columns>
    <column name="status" var="status" notnull="notnull" />
    <column name="pg_tid" var="pg_tid" />
    <column name="paid_date" var="paid_date" />
  </columns>
  <conditions>
    <condition operation="equal" column="order_srl" var="order_srl" notnull="notnull" />
  </conditions>
</query>
