<query id="getHomeBlocks" action="select">
  <tables>
    <table name="ddggshop_home_block" />
  </tables>
  <columns>
    <column name="*" />
  </columns>
  <conditions>
    <condition operation="equal" column="status" var="status" />
  </conditions>
  <navigation>
    <index var="sort_index" default="list_order" order="asc" />
    <list_count var="list_count" default="100" />
  </navigation>
</query>
