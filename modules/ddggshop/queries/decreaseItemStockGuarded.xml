<query id="decreaseItemStockGuarded" action="update">
  <tables>
    <table name="ddggshop_item" />
  </tables>
  <columns>
    <column name="stock" var="qty" operation="minus" notnull="notnull" />
    <column name="buy_count" var="qty" operation="plus" notnull="notnull" />
  </columns>
  <conditions>
    <condition operation="equal" column="item_srl" var="item_srl" notnull="notnull" />
    <condition operation="more" column="stock" var="qty" notnull="notnull" pipe="and" />
  </conditions>
</query>
