<query id="restoreCouponIssue" action="update">
  <tables>
    <table name="ddggshop_coupon_issue" />
  </tables>
  <columns>
    <column name="used" default="N" />
    <column name="order_srl" default="0" />
  </columns>
  <conditions>
    <condition operation="equal" column="coupon_srl" var="coupon_srl" notnull="notnull" />
    <condition operation="equal" column="member_srl" var="member_srl" notnull="notnull" pipe="and" />
    <condition operation="equal" column="order_srl" var="order_srl" notnull="notnull" pipe="and" />
  </conditions>
</query>
