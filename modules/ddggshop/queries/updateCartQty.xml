<query id="updateCartQty" action="update">
  <tables>
    <table name="ddggshop_cart" />
  </tables>
  <columns>
    <column name="qty" var="qty" notnull="notnull" />
  </columns>
  <conditions>
    <condition operation="equal" column="cart_srl" var="cart_srl" notnull="notnull" />
    <condition operation="equal" column="member_srl" var="member_srl" />
    <condition operation="equal" column="session_key" var="session_key" />
  </conditions>
</query>
