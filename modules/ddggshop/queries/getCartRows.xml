<query id="getCartRows" action="select">
  <tables>
    <table name="ddggshop_cart" />
  </tables>
  <columns>
    <column name="*" />
  </columns>
  <conditions>
    <condition operation="equal" column="member_srl" var="member_srl" />
    <condition operation="equal" column="session_key" var="session_key" />
  </conditions>
  <navigation>
    <index var="sort_index" default="cart_srl" order="asc" />
  </navigation>
</query>
