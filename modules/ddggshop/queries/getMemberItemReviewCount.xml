<query id="getMemberItemReviewCount" action="select">
  <tables>
    <table name="ddggshop_review" />
  </tables>
  <columns>
    <column name="count(*)" alias="count" />
  </columns>
  <conditions>
    <condition operation="equal" column="item_srl" var="item_srl" notnull="notnull" />
    <condition operation="equal" column="member_srl" var="member_srl" notnull="notnull" pipe="and" />
  </conditions>
</query>
