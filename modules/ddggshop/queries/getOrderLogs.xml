<query id="getOrderLogs" action="select">
  <tables>
    <table name="ddggshop_order_log" />
  </tables>
  <columns>
    <column name="*" />
  </columns>
  <conditions>
    <condition operation="equal" column="order_srl" var="order_srl" notnull="notnull" />
  </conditions>
  <navigation>
    <index var="sort_index" default="log_srl" order="asc" />
    <list_count var="list_count" default="100" />
  </navigation>
</query>
