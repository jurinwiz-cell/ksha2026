<query id="getPaymentLogList" action="select">
  <tables>
    <table name="ddggshop_payment_log" />
  </tables>
  <columns>
    <column name="*" />
  </columns>
  <conditions>
    <condition operation="equal" column="order_srl" var="order_srl" />
    <condition operation="equal" column="gateway" var="gateway" />
  </conditions>
  <navigation>
    <index var="sort_index" default="log_srl" order="desc" />
    <list_count var="list_count" default="30" />
    <page_count var="page_count" default="10" />
    <page var="page" default="1" />
  </navigation>
</query>
