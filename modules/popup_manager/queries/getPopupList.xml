<?xml version="1.0" encoding="UTF-8"?>
<query id="getPopupList" action="select">
	<tables>
		<table name="popups" />
	</tables>
	<columns>
		<column name="*" />
	</columns>
	<conditions>
		<condition operation="equal" column="is_enabled" var="is_enabled" />
		<condition operation="like" column="title" var="s_title" pipe="and" />
	</conditions>
	<navigation>
		<index var="sort_index" default="popup_srl" order="order_type" />
		<list_count var="list_count" default="20" />
		<page_count var="page_count" default="10" />
		<page var="page" default="1" />
	</navigation>
</query>
