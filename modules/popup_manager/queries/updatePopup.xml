<?xml version="1.0" encoding="UTF-8"?>
<query id="updatePopup" action="update">
	<tables>
		<table name="popups" />
	</tables>
	<columns>
		<column name="popup_type" var="popup_type" />
		<column name="title" var="title" />
		<column name="content" var="content" />
		<column name="image_url" var="image_url" />
		<column name="image_link" var="image_link" />
		<column name="link_target" var="link_target" />
		<column name="position_top" var="position_top" filter="number" />
		<column name="position_left" var="position_left" filter="number" />
		<column name="width" var="width" filter="number" />
		<column name="height" var="height" filter="number" />
		<column name="target_type" var="target_type" />
		<column name="start_date" var="start_date" />
		<column name="end_date" var="end_date" />
		<column name="is_enabled" var="is_enabled" />
		<column name="cookie_days" var="cookie_days" filter="number" />
		<column name="display_order" var="display_order" filter="number" />
		<column name="last_update" var="last_update" default="date('YmdHis')" />
	</columns>
	<conditions>
		<condition operation="equal" column="popup_srl" var="popup_srl" filter="number" notnull="notnull" />
	</conditions>
</query>
