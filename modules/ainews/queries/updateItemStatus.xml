<query id="updateItemStatus" action="update">
    <tables>
        <table name="ainews_items" />
    </tables>
    <columns>
        <column name="status" var="status" notnull="notnull" />
        <column name="last_update" var="last_update" />
    </columns>
    <conditions>
        <condition operation="equal" column="item_srl" var="item_srl" filter="number" notnull="notnull" />
    </conditions>
</query>
